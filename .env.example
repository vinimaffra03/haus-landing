# Supabase — onde o formulário de orçamento grava os leads.
# Sem estas duas variáveis a rota /api/lead responde 503 EM PRODUÇÃO de propósito:
# responder "recebemos" sem ter salvo nada faria vocês perderem lead sem descobrir.
# Em desenvolvimento ela apenas registra no console e segue.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# service_role — SÓ no servidor. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_KEY=eyJhbGciOi...
